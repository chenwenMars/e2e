{
  "name": "@e2e-dev/desktop",
  "version": "0.0.1",
  "description": "Desktop engine for e2e agentic end-to-end testing: native macOS apps through the accessibility tree, driven by a Rust driver loaded in process",
  "keywords": [
    "e2e",
    "end-to-end",
    "testing",
    "ai-testing",
    "desktop-testing",
    "macos",
    "accessibility"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/e2e-inc/e2e.git",
    "directory": "packages/desktop"
  },
  "bugs": {
    "url": "https://github.com/e2e-inc/e2e/issues"
  },
  "homepage": "https://github.com/e2e-inc/e2e/tree/main/packages/desktop#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "tag": "latest"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./engine": {
      "types": "./dist/engine-entry.d.ts",
      "default": "./dist/engine-entry.js"
    }
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc --project tsconfig.build.json && node ../../scripts/stamp-dist.ts",
    "build:native": "node ../../scripts/native/build-native.ts desktop",
    "licenses:native": "node ../../scripts/native/native-licenses.ts desktop",
    "prepublishOnly": "node ../../scripts/check-dist.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit"
  },
  "dependencies": {
    "@napi-rs/image": "1.16.0"
  },
  "optionalDependencies": {
    "@e2e-dev/desktop-darwin-arm64": "workspace:*",
    "@e2e-dev/desktop-darwin-x64": "workspace:*"
  },
  "peerDependencies": {
    "@e2e-dev/core": ">=0.25.1 <1",
    "e2e": ">=0.25.1 <1"
  },
  "peerDependenciesMeta": {
    "e2e": {
      "optional": true
    }
  },
  "devDependencies": {
    "@e2e-dev/core": "workspace:*",
    "@types/node": "26.6.11",
    "e2e": "workspace:*",
    "typescript": "7.0.2",
    "vitest": "5.1.2"
  },
  "engines": {
    "node": "^22.22.3 || >=24.8.0"
  }
}
